# Only the three entry points are reachable over HTTP.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pass the Authorization header through to PHP (needed on some Apache/LiteSpeed setups)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Block internals
    RewriteRule ^(lib|storage)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# SSE must not be compressed or buffered
<Files "stream.php">
    <IfModule mod_deflate.c>
        SetEnv no-gzip 1
    </IfModule>
</Files>
